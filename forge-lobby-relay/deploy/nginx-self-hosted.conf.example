# Merge at TOP LEVEL, alongside http {}, NOT inside http/server/location.
# Replace relay.example.com with YOUR domain and certificate paths.
# Requires nginx stream + stream SSL modules. See README.zh-CN.md.
stream {
    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        ssl_certificate /etc/letsencrypt/live/relay.example.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_handshake_timeout 10s;
        ssl_session_cache shared:FORGE_SELF_HOSTED:10m;
        ssl_session_timeout 10m;
        proxy_pass 127.0.0.1:36744;
        proxy_connect_timeout 10s;
        proxy_timeout 2h;
        # Do NOT enable proxy_protocol: the Forge relay does not decode it.
    }
}
